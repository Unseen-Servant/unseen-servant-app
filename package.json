{
  "name": "unseen-servant-app",
  "version": "4.2.0",
  "description": "Local-first, AI-augmented toolkit for tabletop RPG Gamemasters",
  "author": "Unseen Servant Games <guild@unseenservant.games>",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && npm run messages && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && npm run messages && svelte-check --tsconfig ./tsconfig.json --watch",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --silent",
    "lint:css": "stylelint \"src/lib/**/*.svelte\"",
    "tauri": "tauri",
    "test": "npm run messages && vitest run",
    "test:watch": "npm run messages && vitest"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@xyflow/svelte": "1.7.0",
    "svelte-exmarkdown": "^5.0.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/paraglide-js-svelte": "^1.0.4",
    "@inlang/plugin-message-format": "^4.5.5",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/d3-zoom": "3.0.8"
  }
}
