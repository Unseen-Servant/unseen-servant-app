{
  "name": "unseen-servant-app",
  "version": "4.0.0",
  "description": "Local-first, AI-augmented toolkit for tabletop RPG Gamemasters",
  "author": "Unseen Servant Games <guild@unseenservant.games>",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:local": "bash scripts/build-sidecar.sh && tauri build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:css": "stylelint \"src/lib/**/*.svelte\"",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@xyflow/svelte": "1.7.0",
    "svelte-exmarkdown": "^5.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/d3-zoom": "3.0.8"
  }
}
