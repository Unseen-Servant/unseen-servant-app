{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unseen Servant",
  "version": "3.1.1",
  "identifier": "games.unseenservant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Legend Lore",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "dragDropEnabled": false,
        "create": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Unseen Servant",
        "url": "splash",
        "width": 560,
        "height": 352,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "externalBin": [
      "binaries/legend-lore-sidecar",
      "binaries/legend-lore-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
