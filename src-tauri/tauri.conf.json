{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legend Lore",
  "version": "2.0.2",
  "identifier": "games.unseenservant.legendlore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Legend Lore",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "macOS": {
      "entitlements": "../sidecar/entitlements.plist"
    },
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "externalBin": [
      "binaries/legend-lore-sidecar",
      "binaries/legend-lore-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
