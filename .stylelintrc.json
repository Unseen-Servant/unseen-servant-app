{
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "customSyntax": "postcss-html"
    }
  ],
  "rules": {
    "declaration-property-value-allowed-list": [
      {
        "/^(color|background|background-color|background-image|border|border-top|border-right|border-bottom|border-left|border-color|border-top-color|border-right-color|border-bottom-color|border-left-color|outline|outline-color|box-shadow|text-shadow|fill|stroke|caret-color|accent-color|text-decoration-color|filter)$/": [
          "/^(?!.*(#[0-9a-fA-F]{3}|rgba?\\(|hsla?\\()).*$/"
        ]
      },
      {
        "message": "Raw colors are not allowed in components — use a var(--*) token from src/app.css (add one if needed)."
      }
    ]
  }
}
